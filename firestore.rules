rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 共用驗證函式
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function isRoomMember(roomId) {
      // 檢查發出請求的使用者是否在該房間的 members 陣列中
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    // 1. 使用者資料 (Users)
    match /users/{userId} {
      // 登入者皆可讀取他人基本資料 (用於顯示暱稱、頭像、互評)
      allow read: if isAuthenticated(); 
      // 僅限本人可以修改自己的資料與交友狀態
      allow create, update: if isOwner(userId);
      allow delete: if false; 
    }

    // 2. 房間主資料 (Rooms)
    match /rooms/{roomId} {
      // 登入者皆可讀取 (前端會另外過濾私密與黑名單)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // 允許更新狀態 (實務上可進一步限制僅限房主 hostId 修改)
      allow update: if isAuthenticated(); 
      allow delete: if false;
      
      // 3. 房間內部子集合 (Sub-collections)
      // 嚴格限制：僅限已成功加入該房間的成員才可以讀寫聊天、排程、記事與投票
      match /chats/{document=**} {
        allow read, write: if isRoomMember(roomId);
      }
      match /schedules/{document=**} {
        allow read, write: if isRoomMember(roomId);
      }
      match /bills/{document=**} {
        allow read, write: if isRoomMember(roomId);
      }
      match /votes/{document=**} {
        allow read, write: if isRoomMember(roomId);
      }
      match /memos/{document=**} {
        allow read, write: if isRoomMember(roomId);
      }
    }

    // 4. 邀請碼 (Invite Codes)
    match /invite_codes/{codeId} {
      // 允許未登入者讀取以驗證邀請碼有效性
      allow read: if true;
      // 絕對禁止前端寫入，核銷動作全交由 Cloud Functions (Admin SDK) 處理
      allow write: if false; 
    }
  }
}